{
  "info": {
    "name": "Notes & Bookmark Manager API",
    "description": "Complete API collection for testing the Notes & Bookmark Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notes",
              "host": ["{{base_url}}"],
              "path": ["api", "notes"]
            }
          }
        },
        {
          "name": "Search Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notes?q=meeting&tags=work",
              "host": ["{{base_url}}"],
              "path": ["api", "notes"],
              "query": [
                {
                  "key": "q",
                  "value": "meeting"
                },
                {
                  "key": "tags",
                  "value": "work"
                }
              ]
            }
          }
        },
        {
          "name": "Create Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is the content of my first note\",\n  \"tags\": [\"work\", \"important\"],\n  \"isFavorite\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notes",
              "host": ["{{base_url}}"],
              "path": ["api", "notes"]
            }
          }
        },
        {
          "name": "Get Single Note",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "notes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "NOTE_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Note",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Note Title\",\n  \"content\": \"Updated content\",\n  \"tags\": [\"updated\"],\n  \"isFavorite\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "notes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "NOTE_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "notes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "NOTE_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookmarks",
      "item": [
        {
          "name": "Get All Bookmarks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks"]
            }
          }
        },
        {
          "name": "Search Bookmarks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookmarks?q=react&tags=tutorial",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks"],
              "query": [
                {
                  "key": "q",
                  "value": "react"
                },
                {
                  "key": "tags",
                  "value": "tutorial"
                }
              ]
            }
          }
        },
        {
          "name": "Create Bookmark with Title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://github.com\",\n  \"title\": \"GitHub\",\n  \"description\": \"Where the world builds software\",\n  \"tags\": [\"dev\", \"tools\"],\n  \"isFavorite\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks"]
            }
          }
        },
        {
          "name": "Create Bookmark (Auto-fetch Title)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.npmjs.com\",\n  \"tags\": [\"dev\", \"packages\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks"]
            }
          }
        },
        {
          "name": "Get Single Bookmark",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookmarks/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "BOOKMARK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Bookmark",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Bookmark Title\",\n  \"description\": \"Updated description\",\n  \"tags\": [\"updated\"],\n  \"isFavorite\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookmarks/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "BOOKMARK_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Bookmark",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookmarks/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "bookmarks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "BOOKMARK_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
